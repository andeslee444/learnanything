# .env.example
DATABASE_URL=postgres://learnanything:learnanything@localhost:5433/learnanything
TEST_DATABASE_URL=postgres://learnanything:learnanything@localhost:5433/learnanything_test
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Vercel AI Gateway (https://vercel.com/~/ai-gateway/api-keys). Leave empty + set AI_FAKE_LLM=1 to run without a key.
AI_GATEWAY_API_KEY=
# 1 = serve canned fixtures instead of calling models (tests/e2e/CI)
AI_FAKE_LLM=
# Exa search (https://dashboard.exa.ai). Not needed when AI_FAKE_LLM=1.
EXA_API_KEY=
# Comma-separated list of admin email addresses that can access /admin (founder review queue).
ADMIN_EMAILS=
# OpenAI API key — only needed for live TTS narration (Phase 8). Leave empty + AI_FAKE_LLM=1 for tests.
OPENAI_API_KEY=
# Resend API key (https://resend.com). Absent → structured log transport (no real emails sent).
RESEND_API_KEY=
# From address for outbound email (optional — defaults to 'LearnAnything <onboarding@resend.dev>').
NOTIFY_FROM=
# Bearer secret for Vercel cron routes (/api/cron/*). Absent → routes return 401 (fail closed).
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ── Stripe (Phase 9) ─────────────────────────────────────────────────────────
# Stripe secret key (https://dashboard.stripe.com/apikeys). Absent → billing routes return 503.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (from CLI: stripe listen --print-secret).
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID for the monthly subscription plan (create in Stripe dashboard).
STRIPE_PRICE_ID=
# Public URL of this app — used for Stripe success/cancel redirect URLs.
# Defaults to http://localhost:3000 in code when unset.
APP_URL=
